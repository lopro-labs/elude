# ---- Region / OSM data ----
# Geofabrik extract GraphHopper imports. The default is a small sample extract
# (Delaware) chosen only so a fresh clone imports in ~a minute on any machine.
# Point OSM_PBF_URL at any Geofabrik extract for your area, or the whole US:
#   OSM_PBF_URL=https://download.geofabrik.de/north-america/us-latest.osm.pbf
#   REGION_BBOX=24.4,-125.0,49.4,-66.9
# The whole US needs either ~26 GB RAM (JAVA_OPTS=-Xmx20g, RAM_STORE) or the memory-mapped
# production setup (docker-compose.prod.yml, 24 GB box, JAVA_OPTS=-Xmx14g). See docs/deploy.md.
OSM_PBF_URL=https://download.geofabrik.de/north-america/us/delaware-latest.osm.pbf
# Bounding box used to fetch cameras from Overpass: south,west,north,east
REGION_BBOX=38.4,-75.8,39.9,-75.0

# ---- GraphHopper ----
GH_URL=http://127.0.0.1:8989
GH_PROFILE=car
# A small state import is fine with a small heap. The whole US in RAM_STORE needs -Xmx20g
# (and ~26 GB Docker); the MMAP prod override still needs -Xmx14g for the location-index build.
JAVA_OPTS=-Xmx6g -Xms2g

# ---- Camera avoidance ----
CAMERA_BUFFER_M=30
CAMERA_REFRESH_HOURS=6
# Optional: comma-separated Overpass mirrors (first is primary)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# ---- Geocoding ----
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
# US Census geocoder: free, no key, US-only house-number fallback for street addresses.
# Set GEOCODER_CENSUS=off to disable.
CENSUS_URL=https://geocoding.geo.census.gov
GEOCODER_CENSUS=on

# ---- API server ----
API_PORT=3210
DATA_DIR=./data

# ---- Web ----
# Any MapLibre style JSON URL. OpenFreeMap needs no key.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_API_BASE=/api

# ---- Production only (docker-compose.prod.yml + ONE ingress override; see docs/deploy.md) ----
# Cloudflare Tunnel ingress (docker-compose.tunnel.yml): connector token from Zero Trust.
# TUNNEL_TOKEN=eyJ...
# Caddy ingress (docker-compose.caddy.yml): public hostname for the TLS cert, ACME contact email.
# DOMAIN=elude.example.com
# ACME_EMAIL=you@example.com
# Rate limiting (per IP): global cap, stricter cap for /route + /geocode, window in ms.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_ROUTE_MAX=40
# RATE_LIMIT_WINDOW_MS=60000
# CORS allow-list (comma-separated). Empty = reflect any origin (fine behind the same-origin proxy).
# CORS_ORIGIN=
