{
  "name": "@elude/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "snapshot": "tsx scripts/fetch-fallback.ts"
  },
  "dependencies": {
    "@elude/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@turf/turf": "^7.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.16.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "license": "MIT",
  "description": "Elude API - camera-avoiding route planner backend (Fastify): camera store, avoid geometry, GraphHopper planner"
}
